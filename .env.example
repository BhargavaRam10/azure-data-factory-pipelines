# Deployment parameters. Copy to .env and fill in. NEVER commit the real .env.
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_DATAFACTORY_NAME=your_adf_name
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
BLOB_STORAGE_CONNECTION_STRING=your_connection_string
SERVICE_EVENTS_API_KEY=your_api_key_here
